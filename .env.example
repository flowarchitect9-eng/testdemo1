# Environment Configuration Template

# Trading Mode: TESTNET or PRODUCTION
TRADING_MODE=TESTNET
ENABLE_REAL_MONEY_TRADING=false

# Binance API Credentials
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Database Configuration (Supabase or Local PostgreSQL)
DATABASE_URL=postgresql://postgres.xxx:password@db.xxx.supabase.co:5432/postgres

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Strategy Parameters
SYMBOL=BTCUSDT
TRADE_USD_SIZE=10.0
MAX_HOLD_MINUTES=45
RSI_PERIOD=14
ADX_MIN_THRESHOLD=25.0
